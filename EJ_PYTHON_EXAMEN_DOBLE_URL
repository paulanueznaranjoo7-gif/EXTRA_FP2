class ContainerBase:

    def __str__(self):

        text = "->"

        current = self.first

        while current is not None:

            if current == self.current:
                text += f"{{*{current.url}*}}"
            else:
                text += f"[{current.url}]"

            text += "<->"
            current = current.next

        return text + "None"


class BrowserHistory(ContainerBase):

    class Node:

        def __init__(self, url):
            self.url = url
            self.next = None
            self.prev = None

    def __init__(self):
        self.first = None
        self.last = None
        self.current = None

    def contains(self, url):
        current = self.first
        while current is not None:
            if current.url == url:
                return True
            else:
                current = current.next
        return False
        

    def visit(self, url):
        new_node = self.Node(url)
        if self.first is None:
            self.current = new_node
            self.first = new_node
            self.last = new_node
        else:
            current = self.current.next
            if self.current.next is not None:
                self.current.next = None
                
                
            self.current.next = new_node
            new_node.prev = self.current
            self.current = new_node
        self.last = new_node
            

    def back(self):
        if self.current is None:
            return None
        elif self.current.prev is not None:
            self.current = self.current.prev
            return True
        elif self.current.prev is None:
            return False
            
    def forward(self):
        if self.current is None:
            return None
        elif self.current.next is not None:
            self.current = self.current.next
            return True
        elif self.current.next is None:
            return False
            
    @property
    def current_url(self):
        if self.current is None:
            return None
        else:
            return self.current.url

    @property
    def size(self):
        total_paginas = 0
        current = self.first
        while current is not None:
            total_paginas += 1
            current = current.next
        return total_paginas
    
